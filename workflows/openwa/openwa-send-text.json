    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\":false,\"error\":\"chatId and text are required\",\"example\":{\"sessionId\":\"a3d98a13-0719-4d71-a17d-859f70ec4a9d\",\"chatId\":\"5215512345678@c.us\",\"text\":\"Hola desde n8n\"}}",
        "options": {
          "responseCode": 400
