                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "audio",
                    "leftValue": "={{$json.messageType}}",
                    "rightValue": "audio",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
