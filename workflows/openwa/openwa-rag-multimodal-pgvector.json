              "type": "string",
              "value": "={{$json.body.data.pushName || 'Usuario'}}"
            },
            {
              "id": "message-id",
              "name": "messageId",
              "type": "string",
              "value": "={{$json.body.data.id}}"
            },
            {
              "id": "timestamp",
              "name": "messageTimestamp",
              "type": "number",
              "value": "={{$json.body.data.timestamp || Math.floor(Date.now()/1000)}}"
            },
            {
              "id": "type",
              "name": "messageType",
              "type": "string",
              "value": "={{$json.body.data.type || 'text'}}"
            },
            {
              "id": "text",
              "name": "messageText",
              "type": "string",
              "value": "={{$json.body.data.body || ''}}"
            },
            {
              "id": "media-base64",
              "name": "mediaBase64",
              "type": "string",
              "value": "={{$json.body.data.media?.data || ''}}"
