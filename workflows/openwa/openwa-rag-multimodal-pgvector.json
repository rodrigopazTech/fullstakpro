              "type": "string",
              "value": "={{$json.body.sessionId}}"
            },
            {
              "id": "chat",
              "name": "chatId",
              "type": "string",
              "value": "={{$json.body.data.chatId || $json.body.data.from}}"
            },
            {
              "id": "from",
              "name": "from",
              "type": "string",
              "value": "={{$json.body.data.from}}"
            },
            {
              "id": "name",
