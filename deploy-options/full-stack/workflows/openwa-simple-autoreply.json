{
  "name": "OpenWA Simple Autoreply",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "openwa/simple-reply",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-openwa",
      "name": "Webhook OpenWA",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        260,
        300
      ],
      "webhookId": "openwa-simple-reply"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "from-me",
              "leftValue": "={{$json.body.data.fromMe}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ignore-own",
      "name": "Ignore Own",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "session-id",
              "name": "sessionId",
              "type": "string",
              "value": "={{$json.body.sessionId}}"
            },
            {
              "id": "chat-id",
              "name": "chatId",
              "type": "string",
              "value": "={{$json.body.data.chatId || $json.body.data.from}}"
            },
            {
              "id": "contact-name",
              "name": "contactName",
              "type": "string",
              "value": "={{$json.body.data.pushName || 'Usuario'}}"
            },
            {
              "id": "incoming-text",
              "name": "incomingText",
              "type": "string",
              "value": "={{$json.body.data.body || ''}}"
            }
          ]
        },
        "options": {}
      },
      "id": "normalize-input",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        740,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://openwa_api_proxy:2785/api/sessions/{{$json.sessionId}}/messages/send-text",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={\"X-API-Key\":\"REPLACE_WITH_OPENWA_API_KEY\",\"Content-Type\":\"application/json\"}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"chatId\":\"{{$json.chatId}}\",\"text\":\"Hola {{$json.contactName}}. Esta es una prueba simple desde n8n + OpenWA. Recibi tu mensaje: {{$json.incomingText || '(sin texto)'}}\"}",
        "options": {}
      },
      "id": "openwa-send-text",
      "name": "OpenWA Send Text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        380
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true,\"ignored\":true}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-ignore",
      "name": "Respond Ignore",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        740,
        180
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true,\"sent\":true}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1220,
        380
      ]
    }
  ],
  "connections": {
    "Webhook OpenWA": {
      "main": [
        [
          {
            "node": "Ignore Own",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ignore Own": {
      "main": [
        [
          {
            "node": "Respond Ignore",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Input": {
      "main": [
        [
          {
            "node": "OpenWA Send Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenWA Send Text": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
