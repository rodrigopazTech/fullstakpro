    {
      "parameters": {
        "jsCode": "const raw = $json.buffer_final;\nconst input = Array.isArray(raw) ? raw : raw ? [raw] : [];\nconst messages = [];\nconst seen = new Set();\n\nfor (const item of input) {\n  try {\n    const parsed = typeof item === 'string' ? JSON.parse(item) : item;\n    if (!parsed?.id || seen.has(parsed.id)) continue;\n    seen.add(parsed.id);\n    messages.push(parsed);\n  } catch {}\n}\n\nmessages.sort((a, b) => Number(a.timestamp || 0) - Number(b.timestamp || 0));\nconst combinedText = messages.map(m => m.text).filter(Boolean).join('\\n').trim() || $('Normalize OpenWA Message').item.json.messageText;\n\nreturn [{\n  json: {\n    sessionId: $('Normalize OpenWA Message').item.json.sessionId,\n    chatId: $('Normalize OpenWA Message').item.json.chatId,\n    contactName: $('Normalize OpenWA Message').item.json.contactName,\n    question: combinedText,\n    messageCount: messages.length || 1,\n    source: 'openwa-buffer'\n  }\n}];"
      },
      "id": "combine-messages",
      "name": "Combine Buffered Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2900,
        500
      ]
    },
