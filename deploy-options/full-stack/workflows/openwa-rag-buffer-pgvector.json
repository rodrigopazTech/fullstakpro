      "id": "normalize-openwa-message",
      "name": "Normalize OpenWA Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        740,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-text",
              "leftValue": "={{$json.messageText}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-text",
      "name": "Has Text",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        980,
        500
      ]
    },
    {
      "parameters": {
        "operation": "push",
        "list": "={{$json.bufferKey}}",
        "messageData": "={{JSON.stringify({ id: $json.messageId, timestamp: $json.messageTimestamp, text: $json.messageText })}}",
        "tail": true
      },
      "id": "redis-push",
      "name": "Redis Push Message",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1220,
        500
      ],
      "credentials": {
        "redis": {
          "id": "jG98UsOEoIof0zKf",
          "name": "Redis Chat Memory Local"
        }
      }
    },
    {
      "parameters": {
        "operation": "get",
        "propertyName": "buffer_list",
        "key": "={{$json.bufferKey}}",
        "options": {}
      },
      "id": "redis-get-buffer",
      "name": "Redis Get Buffer",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1460,
        500
      ],
      "credentials": {
        "redis": {
          "id": "jG98UsOEoIof0zKf",
          "name": "Redis Chat Memory Local"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.buffer_list;\nconst currentId = $('Normalize OpenWA Message').item.json.messageId;\nconst currentTimestamp = $('Normalize OpenWA Message').item.json.messageTimestamp;\n\nconst input = Array.isArray(raw) ? raw : raw ? [raw] : [];\nconst messages = [];\nconst seen = new Set();\n\nfor (const item of input) {\n  try {\n    const parsed = typeof item === 'string' ? JSON.parse(item) : item;\n    if (!parsed?.id || seen.has(parsed.id)) continue;\n    seen.add(parsed.id);\n    messages.push(parsed);\n  } catch {}\n}\n\nmessages.sort((a, b) => Number(a.timestamp || 0) - Number(b.timestamp || 0));\n\nconst first = messages[0] || { id: currentId, timestamp: currentTimestamp };\nconst now = Math.floor(Date.now() / 1000);\nconst elapsedSeconds = now - Number(first.timestamp || currentTimestamp || now);\nconst isLeader = first.id === currentId;\n\nlet action = 'ignore';\nif (isLeader && elapsedSeconds >= 15) {\n  action = 'process';\n} else if (isLeader) {\n  action = 'wait';\n}\n\nreturn [{\n  json: {\n    action,\n    isLeader,\n    elapsedSeconds,\n    messageCount: messages.length,\n    firstMessageId: first.id,\n    currentMessageId: currentId,\n    bufferKey: $('Normalize OpenWA Message').item.json.bufferKey\n  }\n}];"
      },
      "id": "analyze-buffer",
      "name": "Analyze Buffer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        500
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "ignore",
                    "leftValue": "={{$json.action}}",
                    "rightValue": "ignore",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Ignore"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "wait",
                    "leftValue": "={{$json.action}}",
                    "rightValue": "wait",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Wait"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "process",
                    "leftValue": "={{$json.action}}",
                    "rightValue": "process",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Process"
            }
          ]
        },
        "options": {}
      },
      "id": "switch-action",
      "name": "Switch Action",
      "type": "n8n-nodes-base.switch",
