# ============================================
# CONFIGURACIÓN DEL SERVIDOR VPS
# Copia este archivo como .env y completa los valores
# ============================================

# IP del servidor
SERVER_IP=127.0.0.1

# ============================================
# BASE DE DATOS (PostgreSQL con pgvector)
# ============================================
POSTGRES_USER=rodrigo_db_admin
POSTGRES_PASSWORD=test_db_pass_123

# ============================================
# REDIS
# ============================================
REDIS_PASSWORD=test_redis_pass_123

# ============================================
# N8N (Modo Queue con Worker)
# ============================================
N8N_HOST=0.0.0.0
# Genera con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=test_n8n_key_789

# ============================================
# EVOLUTION API
# ============================================
# Tu API key para autenticación
EVOLUTION_API_KEY=test_evo_key_321

# ============================================
# CHATWOOT
# ============================================
# Genera con: openssl rand -hex 64
CHATWOOT_SECRET_KEY=test_chatwoot_secret_456

# ============================================
# EMAIL (Opcional - Para notificaciones)
# Puedes usar Resend, SendGrid, Gmail SMTP, etc.
# ============================================
MAILER_SENDER_EMAIL=noreply@tudominio.com
SMTP_DOMAIN=localhost
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ============================================
# OLLAMA
# Proxy opcional para descargas de modelos
# IMPORTANTE: usar HTTPS_PROXY, no HTTP_PROXY
# ============================================
OLLAMA_HTTPS_PROXY=
OLLAMA_NO_PROXY=localhost,127.0.0.1,ollama,postgres,redis,n8n,n8n_main,n8n_worker_1
